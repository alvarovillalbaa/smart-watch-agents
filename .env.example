# Externally reachable HTTPS URL. Watches must be able to reach this address.
HUB_PUBLIC_URL=https://hub.example.com
DATABASE_URL=postgres://watch_agents:watch_agents@postgres:5432/watch_agents
HUB_BOOTSTRAP_SECRET=replace-with-a-long-random-secret
HUB_CONNECTOR_TOKEN=replace-with-a-long-random-secret
HUB_DEFAULT_TIMEZONE=Europe/Madrid
# Configure these in production before enabling remote pushes.
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=
# JSON for a Firebase service account with Firebase Cloud Messaging permission.
# Keep this secret out of Git; use an absolute mounted path in Docker.
FCM_SERVICE_ACCOUNT_JSON=
