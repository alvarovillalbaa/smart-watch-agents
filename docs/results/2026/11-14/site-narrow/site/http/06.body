:root{color-scheme:light dark;--bg:#f5f3ed;--paper:#fffefa;--ink:#24382f;--muted:#738078;--line:#dedfd5;--green:#365e46;--soft:#e8eee4;--orange:#8c5b2b;--orange-soft:#faf0dc;--red:#a0413b;--shadow:0 15px 50px #23352b09;font-family:system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;color:var(--ink);background:var(--bg)}*{box-sizing:border-box}body{margin:0}button,input,select{font:inherit;color:inherit}button,a,input,select,summary{-webkit-tap-highlight-color:transparent}button{cursor:pointer;min-height:42px;border:1px solid var(--line);border-radius:7px;background:var(--paper);padding:10px 15px;font-size:.8rem;font-weight:600}button:hover{border-color:var(--green)}button:disabled{opacity:.45;cursor:default}button:focus-visible,a:focus-visible,input:focus-visible,select:focus-visible,summary:focus-visible{outline:3px solid #80a687;outline-offset:3px}a{color:var(--green)}header,main,footer{max-width:1320px;margin:auto;padding-left:48px;padding-right:48px}header{display:flex;align-items:center;justify-content:space-between;gap:20px;min-height:115px;border-bottom:1px solid var(--line)}.brand{display:flex;align-items:center;gap:12px;text-decoration:none;color:var(--ink);font-size:1.15rem;font-weight:750;letter-spacing:-.04em}.brand small{display:block;font:8px/1.5 ui-monospace,monospace;letter-spacing:.13em;color:var(--muted);margin-top:4px}.brand-mark{display:flex;align-items:center;justify-content:center;background:var(--green);color:var(--paper);border-radius:12px;width:45px;height:45px;font:italic 20px Georgia,serif;letter-spacing:-2px;padding-right:2px}.header-actions{display:flex;align-items:center;gap:8px;min-width:0}.connection{font-size:.72rem;max-width:260px;overflow-wrap:anywhere;margin-right:12px}.connection:before{content:"";display:inline-block;width:6px;height:6px;border-radius:50%;background:var(--muted);margin-right:7px}.connection.connected:before{background:#4a8a5b}.quiet{background:transparent}.primary{background:var(--green);color:#fff;border-color:var(--green)}.text-button{background:transparent;border:0;padding:8px 0;text-decoration:underline;text-underline-offset:3px;font-size:.73rem;color:var(--muted);text-align:left}.intro{display:flex;justify-content:space-between;gap:50px;padding:65px 0 43px}.eyebrow{font:10px/1.5 ui-monospace,monospace;letter-spacing:.12em;color:var(--muted);margin:0 0 16px}.intro h1{font:500 clamp(2.7rem,4.7vw,4.4rem)/1.03 Georgia,"Times New Roman",serif;letter-spacing:-.055em;margin:0 0 24px}.lead{max-width:520px;font-size:.92rem;line-height:1.75;color:var(--muted);margin:0}.time-note{align-self:flex-end;flex-shrink:0;padding:0 0 0 26px;border-left:1px solid var(--line);font-size:.77rem;line-height:1.8;color:var(--muted);margin-bottom:5px}.time-note>span{font:10px ui-monospace,monospace;text-transform:uppercase;letter-spacing:.08em}.time-note p{margin:10px 0 0}.notice{border:1px solid var(--line);background:var(--soft);border-radius:8px;padding:13px 17px;font-size:.8rem;line-height:1.6;overflow-wrap:anywhere;margin:0 0 22px}.notice.error{color:var(--red);background:var(--paper);border-color:#cfaaa1}.panel{background:var(--paper);border:1px solid var(--line);border-radius:12px;box-shadow:var(--shadow)}.setup{display:grid;grid-template-columns:1fr 1fr;gap:55px;padding:30px;margin:0 0 24px}.setup[hidden]{display:none}h2{font:500 1.7rem/1.2 Georgia,serif;letter-spacing:-.04em;margin:0}.setup p:not(.eyebrow){font-size:.8rem;line-height:1.7}.muted{color:var(--muted);font-size:.75rem;line-height:1.65}code{font:11px/1.5 ui-monospace,monospace;overflow-wrap:anywhere}label{font-size:.73rem;display:block;color:var(--muted)}input,select{display:block;width:100%;min-height:43px;margin:7px 0 14px;border:1px solid var(--line);border-radius:6px;background:var(--paper);padding:11px 12px;font-size:.82rem;min-width:0}.form-row{display:grid;grid-template-columns:1fr 1fr;gap:14px}.stats{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));border:1px solid var(--line);border-radius:10px;margin:25px 0 45px;background:var(--paper);overflow:hidden}.stats>div{padding:23px 25px;border-right:1px solid var(--line)}.stats>div:last-child{border:0}.stat-title{font:9px/1.5 ui-monospace,monospace;letter-spacing:.08em;color:var(--muted)}.stats strong{font:500 2.5rem/1.3 Georgia,serif;display:block;letter-spacing:-.05em;margin:8px 0 3px}.stats p{font-size:.72rem;color:var(--muted);margin:0}.workspace{display:grid;grid-template-columns:minmax(0,1fr) 290px;gap:45px;margin-bottom:65px}.section-heading{display:flex;align-items:flex-end;justify-content:space-between;gap:15px;margin-bottom:20px}.section-heading .eyebrow{margin-bottom:10px}.section-heading h2{font-size:1.65rem}.section-heading>span{text-align:right;font-size:.67rem}.filter-bar{display:flex;gap:12px;padding:16px 0 9px;border-top:1px solid var(--line)}.filter-bar>.search-label{flex:1;min-width:0}.filter-bar>label:last-child{width:150px}.run-card{padding:23px;margin:0 0 12px;min-width:0}.run-top{display:flex;justify-content:space-between;align-items:flex-start;gap:12px}.run-title{font-size:.94rem;line-height:1.45;margin:0;letter-spacing:-.02em;overflow-wrap:anywhere}.run-agent{font:10px/1.8 ui-monospace,monospace;color:var(--muted);overflow-wrap:anywhere;margin:7px 0}.badge{display:inline-block;white-space:nowrap;font:10px/1.5 ui-monospace,monospace;background:var(--soft);padding:4px 8px;border-radius:5px;flex-shrink:0}.badge.attention{background:var(--orange-soft);color:var(--orange)}.badge.failed{color:var(--red);background:var(--bg)}.run-summary{font-size:.8rem;color:var(--muted);line-height:1.8;overflow-wrap:anywhere;margin:16px 0}.run-footer{display:flex;gap:9px;align-items:center;flex-wrap:wrap;border-top:1px solid var(--line);padding-top:14px;margin-top:15px}.run-footer>span{font-size:.67rem;color:var(--muted);margin-right:auto}.run-footer button{font-size:.72rem;min-height:38px;padding:8px 11px}.empty{padding:38px 25px;text-align:center;border:1px dashed var(--line);border-radius:10px;color:var(--muted);font-size:.82rem;line-height:1.8}.activity-column{padding-left:25px;border-left:1px solid var(--line);min-width:0}.activity-column>.muted{font-size:.73rem}.intent{padding:16px 0;border-bottom:1px solid var(--line);min-width:0}.intent h3{font-size:.8rem;line-height:1.6;margin:0;overflow-wrap:anywhere}.intent p{font-size:.67rem;line-height:1.7;color:var(--muted);overflow-wrap:anywhere;margin:7px 0}.intent .intent-status{color:var(--green);font-weight:600}.intent .uncertain{color:var(--orange)}.intent button{font-size:.7rem;min-height:37px}.intent code{font-size:9px;display:block;overflow-wrap:anywhere}dialog{border:1px solid var(--line);border-radius:14px;max-width:580px;width:calc(100% - 36px);background:var(--paper);color:var(--ink);padding:30px;box-shadow:0 30px 100px #14211c40}dialog::backdrop{background:#13271c66;backdrop-filter:blur(4px)}.dialog-close{float:right;font-size:.7rem}.dialog-actions{display:flex;justify-content:flex-end;gap:10px;margin-top:25px;flex-wrap:wrap}dialog pre{font:12px/1.8 ui-monospace,monospace;white-space:pre-wrap;overflow-wrap:anywhere;max-height:300px;overflow:auto;padding:18px;border:1px solid var(--line);background:var(--bg);border-radius:8px}footer{display:flex;justify-content:space-between;gap:20px;border-top:1px solid var(--line);font-size:.66rem;color:var(--muted);padding-top:25px;padding-bottom:35px;line-height:1.8}footer p{margin:0}footer a{color:var(--muted)}
@media(prefers-color-scheme:dark){:root{--bg:#16251f;--paper:#1c2d24;--ink:#e4e8d9;--muted:#9cae9e;--line:#35463b;--green:#648867;--soft:#2b4031;--orange:#e8bd7c;--orange-soft:#493e2a;--red:#ec9d91;--shadow:none}.brand-mark{color:#fff}.primary{color:#fff}.notice.error{border-color:#754c46}}
@media(max-width:1000px){header,main,footer{padding-left:30px;padding-right:30px}.workspace{grid-template-columns:minmax(0,1fr) 240px;gap:25px}.activity-column{padding-left:20px}.stats>div{padding:20px 18px}.connection{max-width:170px}.setup{gap:30px}.time-note{display:none}}
@media(max-width:700px){header,main,footer{padding-left:20px;padding-right:20px}header{flex-wrap:wrap;gap:18px;padding-top:22px;padding-bottom:20px;min-height:0}.header-actions{width:100%;justify-content:flex-end}.connection{margin-right:auto;font-size:.65rem;max-width:160px}.header-actions button{font-size:.68rem;padding:8px 10px;min-height:40px}.intro{padding:40px 0 30px}.intro h1{font-size:3.1rem}.lead{font-size:.85rem}.stats{grid-template-columns:1fr 1fr;margin-bottom:35px}.stats>div{padding:18px;border-bottom:1px solid var(--line)}.stats>div:nth-child(2){border-right:0}.stats>div:nth-child(n+3){border-bottom:0}.stats strong{font-size:2.2rem}.stat-title{font-size:8px}.stats p{font-size:.66rem}.workspace{grid-template-columns:minmax(0,1fr);gap:40px}.activity-column{padding-left:0;border-left:0;border-top:1px solid var(--line);padding-top:28px}.setup{grid-template-columns:minmax(0,1fr);gap:20px;padding:22px}.form-row{grid-template-columns:1fr;gap:0}.section-heading{align-items:flex-start}.section-heading>span{max-width:115px;font-size:.62rem}.section-heading h2{font-size:1.5rem}.run-card{padding:20px}.run-top{flex-direction:column;gap:8px}.filter-bar>label:last-child{width:120px}.filter-bar input,.filter-bar select{font-size:.73rem}.run-footer{align-items:flex-start}.run-footer>span{width:100%;margin-bottom:4px}.run-footer button{min-height:44px}.intent button{min-height:44px}dialog{padding:22px}footer{flex-direction:column;gap:8px}.notice{font-size:.74rem}button{min-height:44px}}
