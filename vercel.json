{
  "framework": null,
  "installCommand": "node --version",
  "buildCommand": "node scripts/build-site.mjs",
  "outputDirectory": "dist",
  "headers": [
    {"source": "/(.*)", "headers": [
      {"key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'self'; frame-ancestors 'none'; base-uri 'none'; form-action 'none'"},
      {"key": "Referrer-Policy", "value": "no-referrer"},
      {"key": "X-Content-Type-Options", "value": "nosniff"},
      {"key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()"}
    ]},
    {"source": "/build-manifest.json", "headers": [{"key":"Cache-Control","value":"no-store"}]}
  ]
}
